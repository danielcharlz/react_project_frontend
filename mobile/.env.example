# Optional. Leave unset and the app uses the IP of the computer running `expo start`.
# Set it if the app can't reach the backend, e.g. on an Android emulator:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# or on a phone, your computer's Wi-Fi IP (find it with `ipconfig`):
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:4000
